<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>e8d86968-ba03-4abf-b5a9-b2c5bb85d2a5</UserSecretsId>
    <SpaRoot>..\FacetsUI\</SpaRoot>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.10.4" />
    <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.0" />
    <PackageReference Include="MicroElements.Swashbuckle.FluentValidation" Version="6.0.0" />
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="2.22.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
    <PackageReference Include="Swashbuckle.AspNetCore.Annotations" Version="6.5.0" />
    <PackageReference Include="Unchase.Swashbuckle.AspNetCore.Extensions" Version="2.7.1" />
    <PackageReference Include="WatchDog.NET" Version="1.4.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Facets.Infrastructure\Facets.Infrastructure.csproj" />
    <ProjectReference Include="..\Facets.Persistence\Facets.Persistence.csproj" />
    <ProjectReference Include="..\Facets.SharedKernal\Facets.SharedKernal.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Don't publish the SPA source files, but do show them in the project files list -->
    <Content Remove="$(SpaRoot)**" />
    <None Remove="$(SpaRoot)**" />
    <None Include="$(SpaRoot)**" Exclude="$(SpaRoot)node_modules\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="..\FacetsUI\.angular\cache\16.1.0\**" />
    <None Remove="..\FacetsUI\.vscode\**" />
    <None Remove="..\FacetsUI\dist\**" />
    <None Remove="..\FacetsUI\src\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="..\FacetsUI\.editorconfig" />
    <None Remove="..\FacetsUI\.gitignore" />
    <None Remove="..\FacetsUI\angular.json" />
    <None Remove="..\FacetsUI\ngsw-config.json" />
    <None Remove="..\FacetsUI\package-lock.json" />
    <None Remove="..\FacetsUI\package.json" />
    <None Remove="..\FacetsUI\README.md" />
    <None Remove="..\FacetsUI\tsconfig.app.json" />
    <None Remove="..\FacetsUI\tsconfig.json" />
    <None Remove="..\FacetsUI\tsconfig.spec.json" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\" />
  </ItemGroup>

  <Target Name="DebugEnsureNodeEnv" BeforeTargets="Build" Condition=" '$(Configuration)' == 'Debug' And !Exists('$(SpaRoot)node_modules') ">
    <!-- Ensure Node.js is installed -->
    <Exec Command="node --version" ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="ErrorCode" />
    </Exec>
    <Error Condition="'$(ErrorCode)' != '0'" Text="Node.js is required to build and run this project. To continue, please install Node.js from https://nodejs.org/, and then restart your command prompt or IDE." />
    <Message Importance="high" Text="Restoring dependencies using 'npm'. This may take several minutes..." />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm install --legacy-peer-deps" />
  </Target>

  <Target Name="PublishRunWebpack" AfterTargets="ComputeFilesToPublish">
    <!--
      As part of publishing, build the Angular site in production mode so wwwroot always contains the
      current frontend. Previously these steps were commented out, so a publish shipped whatever old
      FacetsUI\dist happened to be on the publishing machine, or no frontend at all.
      Requires Node.js on the machine that publishes. To publish a dist you built yourself, pass
      /p:SkipSpaBuild=true (dotnet publish -c Release /p:SkipSpaBuild=true).
    -->
    <Exec Condition=" '$(SkipSpaBuild)' != 'true' " WorkingDirectory="$(SpaRoot)" Command="npm install --legacy-peer-deps" />
    <Exec Condition=" '$(SkipSpaBuild)' != 'true' " WorkingDirectory="$(SpaRoot)" Command="npm run build -- --configuration production" />
    <Error Condition="!Exists('$(SpaRoot)dist\index.html')" Text="The Angular build output (FacetsUI\dist\index.html) is missing, so the published site would have no frontend. Run 'npm run build' in FacetsUI, or publish without /p:SkipSpaBuild=true." />

    <!-- Include the newly-built files in the publish output -->
    <ItemGroup>
      <DistFiles Include="$(SpaRoot)dist\**; $(SpaRoot)dist-server\**" />
      <ResolvedFileToPublish Include="@(DistFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot\%(RecursiveDir)%(FileName)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
